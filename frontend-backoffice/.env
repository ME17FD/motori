# API Gateway Configuration
# The gateway acts as the single entry point for all backend services
VITE_API_GATEWAY_URL=https://backofficemotori.me-fd.com/api
VITE_API_BASE_URL=https://backofficemotori.me-fd.com/api

# CORS Origins (from gateway configuration)
# These should match the allowed-origins in gateway application.yml
# - http://localhost:5173 (development)
# - https://motori.me-fd.com (production)
# - https://backoffice.motori.me-fd.com (production backoffice)

# Gateway Routes (for reference)
# All API calls go through the gateway at /api/*
# - /api/auth/* → user-service
# - /api/users/* → user-service
# - /api/products/* → product-service
# - /api/orders/* → backoffice-service
# - /api/statistics/* → backoffice-service
# - /api/payments/* → payment-service